# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Shared secret with the Next.js frontend — must match FRONTEND_INTERNAL_API_KEY
# in the frontend's .env. Generate your own with: openssl rand -hex 24
INTERNAL_API_KEY="replace-with-a-random-string"

# Which origin is allowed to call this service (CORS)
FRONTEND_ORIGIN="http://localhost:3000"
