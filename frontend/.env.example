# SQLite for local dev — zero setup
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Python AI backend
AI_BACKEND_URL="http://localhost:8000"

# Must exactly match INTERNAL_API_KEY in backend/.env
FRONTEND_INTERNAL_API_KEY="replace-with-the-same-value-as-backend-INTERNAL_API_KEY"
